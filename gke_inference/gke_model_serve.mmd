flowchart TD
  client["Clients / Apps"] --> cdn["Cloud Load Balancer"]
  cdn --> gw["Gateway API / Ingress"]
  gw --> router["Inference Gateway + Router"]
  router --> c["Canary v2 Pods"]
  router --> s["Stable v1 Pods"]
  s --> gpu["GPU Node Pool (A3 / L4 / T4)"]
  c --> gpu
  s --> reg["Model Registry (Vertex AI / GCS)"]
  c --> reg
  router --> obs["Autoscaling + Observability"]
